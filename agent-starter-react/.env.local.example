# ============================================================
# agent-starter-react frontend env — TEMPLATE
# ============================================================
# Copy this file to .env.local (alongside it) and fill in real values.
# The real .env.local is gitignored — never commit it.
#
# Next.js auto-loads .env.local at server start. These values are used by:
#   - app/api/token/route.ts (the server-side Next.js token-mint route)
#   - any server component / server action that reads process.env
#
# Anything that needs to be visible in the BROWSER must be prefixed
# NEXT_PUBLIC_  — Next.js strips non-prefixed vars from the client bundle.
# (The MVP works around this by hardcoding agentName in app-config.ts.)
# ============================================================

# ---- LiveKit (server-side use only) ----
# WebSocket URL of the SFU that the BROWSER will connect to.
# Browser connects directly; this URL must be reachable from end-user networks.
# MVP value: ws://3.227.63.49:7880  (shared EC2 public IP, no TLS)
# Production: wss://sophia.example.com  (with TLS terminating at LB or SFU)
LIVEKIT_URL=ws://3.227.63.49:7880

# LiveKit API key + secret — used by app/api/token/route.ts to mint JWTs
# server-side. MUST match the values in sophia-agent/.env.production and the
# keys: block in sophia-agent/infra/livekit.prod.yaml.
LIVEKIT_API_KEY=REPLACE_ME_32_HEX_CHARS
LIVEKIT_API_SECRET=REPLACE_ME_64_HEX_CHARS

# ---- Agent identity ----
# Name of the agent worker (registered in sophia-agent/src/agent.py).
# NOTE: this is currently REDUNDANT — agent-starter-react/app-config.ts
# hardcodes agentName='sophia-agent' because non-NEXT_PUBLIC env vars
# don't survive the client bundle. Kept here for documentation; can be
# removed once that hardcode is replaced with a proper config pattern.
AGENT_NAME=sophia-agent
