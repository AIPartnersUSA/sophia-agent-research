# ============================================================
# sophia-agent backend production env — TEMPLATE
# ============================================================
# Copy this file to .env.production (alongside it) and fill in real values.
# The real .env.production is gitignored — never commit it.
#
# On EC2, this file lives at /workspace/avinash/sophia/sophia-agent/.env.production
# and is loaded via env_file directives in docker-compose.yml for the
# token-mint and agent-worker containers.
#
# chmod 600 the real file after creating it.
# ============================================================

# ---- LiveKit SFU ----
# The WebSocket URL the agent-worker uses to register with the SFU.
# When SFU + worker are co-located (docker-compose host network): ws://localhost:7880
# When SFU is elsewhere: ws://<sfu-host>:7880  (or wss:// for TLS in production)
LIVEKIT_URL=ws://localhost:7880

# LiveKit API key + secret. MUST match the keys: block in livekit.prod.yaml.
# Generate fresh values:
#   LIVEKIT_API_KEY:    openssl rand -hex 16   (32 hex chars)
#   LIVEKIT_API_SECRET: openssl rand -hex 32   (64 hex chars)
# These are used by token-mint to sign JWTs that the SFU then verifies.
LIVEKIT_API_KEY=REPLACE_ME_32_HEX_CHARS
LIVEKIT_API_SECRET=REPLACE_ME_64_HEX_CHARS

# ---- token-mint auth ----
# Shared X-API-Key value clients send in the X-API-Key header on POST /token.
# Generate: openssl rand -hex 16
# Leave UNSET (comment out entirely) to disable auth — the MVP-only escape hatch.
# Production should replace this with real per-user auth (Auth0, Cognito, etc).
SOPHIA_TOKEN_API_KEY=REPLACE_ME_32_HEX_CHARS

# ---- CORS ----
# Allowed origins for the token-mint endpoint. * = all (MVP only).
# Production should restrict to your real domain(s):
#   SOPHIA_CORS_ORIGINS=https://sophia.example.com,https://staging-sophia.example.com
SOPHIA_CORS_ORIGINS=*

# ---- Inference service URLs ----
# Where the agent-worker reaches the four inference services.
# In the MVP on EC2 these are localhost because pf-gpu.sh runs kubectl
# port-forwards from EC2 → EKS in us-west-2.
# In production with same-cluster deployment they would be:
#   WHISPER_URL=http://whisper-inference.multi-agent.svc.cluster.local:8080
#   QWEN3_URL=http://qwen3-inference.multi-agent.svc.cluster.local:8080
#   KOKORO_URL=http://kokoro-tts.multi-agent.svc.cluster.local:8122
#   SOPHIA_RAG_URL=http://sophia-spatial-ai.multi-agent.svc.cluster.local:8106
WHISPER_URL=http://localhost:8080
QWEN3_URL=http://localhost:18080
KOKORO_URL=http://localhost:8122
SOPHIA_RAG_URL=http://localhost:8106
