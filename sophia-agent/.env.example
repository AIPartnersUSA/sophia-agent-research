# LiveKit SFU (local self-hosted, NOT LiveKit Cloud).
# Matches the keys section in infra/livekit.yaml -- if you change one, change both.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-please-change

# AWS model endpoints (filled in by user when ready).
# If the endpoint speaks OpenAI-compatible HTTP, we use livekit.plugins.openai with
# base_url=<this value>. Otherwise we write a custom plugin in src/plugins/.
SOPHIA_STT_URL=
SOPHIA_STT_API_KEY=
SOPHIA_TTS_URL=
SOPHIA_TTS_API_KEY=
SOPHIA_LLM_URL=
SOPHIA_LLM_API_KEY=
