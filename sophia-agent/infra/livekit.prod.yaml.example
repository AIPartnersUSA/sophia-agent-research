# ============================================================
# LiveKit server config — TEMPLATE
# ============================================================
# Copy this file to livekit.prod.yaml (alongside it) and fill in real values.
# The real livekit.prod.yaml is gitignored — never commit it.
#
# On EC2, this file lives at:
#   /workspace/avinash/sophia/sophia-agent/infra/livekit.prod.yaml
# and is mounted into the livekit-server container at /etc/livekit.yaml
# (see docker-compose.yml volumes section).
#
# chmod 600 the real file after creating it.
# ============================================================

# Signal port (WebSocket). 7880 is the LiveKit default.
port: 7880

# WebRTC media transport
rtc:
  # TCP fallback port (used when UDP is blocked, e.g. corporate networks)
  tcp_port: 7881

  # UDP port range for media. Must match the SG / k8s NetworkPolicy / hostPort
  # range. 10,000 ports is generous; can shrink for stricter envs.
  port_range_start: 50000
  port_range_end: 60000

  # Set to true if the SFU is behind NAT and needs to discover its external IP.
  # In docker-compose host networking with --node-ip set on the CLI, leave false.
  # On k8s with hostNetwork, also leave false (the host's real IP is visible).
  use_external_ip: false

# ============================================================
# API key + secret pair
# ============================================================
# This is the IDENTITY the SFU uses to verify JWTs minted by token-mint.
# MUST match LIVEKIT_API_KEY + LIVEKIT_API_SECRET in .env.production exactly.
#
# Generate fresh values:
#   key:    openssl rand -hex 16   (32 hex chars)
#   secret: openssl rand -hex 32   (64 hex chars)
#
# Multiple key:secret pairs are supported (for key rotation):
#   keys:
#     old_key: old_secret
#     new_key: new_secret
# During rotation, mint JWTs with the new pair while the SFU still accepts the old.
keys:
  REPLACE_ME_32_HEX_KEY: REPLACE_ME_64_HEX_SECRET

# Logging
logging:
  level: info       # debug | info | warn | error
  json: false       # true for structured logs in production (better for parsers)
